---
---
<nav class="nav">
  <div class="nav-inner">
    <a class="brand" href="#top">HOMEPRO<span>&bull;</span>SERVICES</a>
    <div class="nav-links">
      <a href="#services" data-i18n="nav_services">Services</a>
      <a href="#results" data-i18n="nav_results">Results</a>
      <a href="#dashboard" data-i18n="nav_dashboard">Dashboard</a>
      <a href="#transformation" data-i18n="nav_portfolio">Portfolio</a>
      <a href="#faq" data-i18n="nav_faq">FAQ</a>
    </div>
    <div style="display:flex;gap:10px;align-items:center;justify-self:end">
      <div class="lang-switcher">
        <button class="lang-btn active" data-lang="en">EN</button>
        <button class="lang-btn" data-lang="pt">PT</button>
        <button class="lang-btn" data-lang="es">ES</button>
      </div>
      <a class="nav-cta" href="#contact" data-i18n="nav_cta">Get a free quote</a>
    </div>
  </div>
</nav>

<style>
  .nav { position: fixed; top: 9px; left: 0; right: 0; z-index: 100; padding: 18px 24px; display: flex; justify-content: center }
  .nav-inner { width: min(var(--max),100%); display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 16px;
    padding: 12px 14px; border: 1px solid rgba(255,255,255,.11); border-radius: 18px;
    background: rgba(4,5,7,.54); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px) }
  .brand { font-family: "Space Grotesk"; font-weight: 700; letter-spacing: .12em; font-size: 15px }
  .brand span { color: var(--red) }
  .nav-links { display: flex; gap: 28px; font-size: 11px; color: #cfd2d8 }
  .nav-links a { opacity: .75; transition: .25s }
  .nav-links a:hover { opacity: 1 }
  .nav-cta { justify-self: end; border: 1px solid var(--line); padding: 9px 14px; border-radius: 999px; font-size: 11px }

  .lang-switcher { display: flex; gap: 0; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; justify-self: end }
  .lang-btn { background: none; border: none; color: #777e87; font-size: 10px; padding: 7px 11px; cursor: pointer; transition: .25s; font-family: Inter, system-ui, sans-serif; letter-spacing: .06em }
  .lang-btn:hover { color: #fff }
  .lang-btn.active { background: rgba(255,255,255,.1); color: #fff }

  @media (max-width: 850px) {
    .nav-links { display: none }
    .nav-inner { grid-template-columns: 1fr auto }
  }
</style>
