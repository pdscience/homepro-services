---
---
<section class="section" id="dashboard">
  <div class="section-head reveal">
    <div><div class="kicker" data-i18n="s3_kicker">03 / Dashboard</div><h2 data-i18n="s3_h1">Service<br>tracker.</h2></div>
    <p data-i18n="s3_desc">A real-time view of your service operations — response times, completions and customer satisfaction.</p>
  </div>
  <div class="ads reveal">
    <div class="ads-head"><span class="ads-dot"></span><b data-i18n="dash_head">Service Dashboard</b><span>&middot;</span><span data-i18n="dash_sub">Performance / All services</span><span style="margin-left:auto">Today, 02:14</span></div>
    <div class="ads-body">
      <div class="ads-grid">
        <div class="ads-kpi"><small data-i18n="kpi1">JOBS COMPLETED</small><strong id="impressions">1,842</strong></div>
        <div class="ads-kpi"><small data-i18n="kpi2">5-STAR REVIEWS</small><strong id="clicks">947</strong></div>
        <div class="ads-kpi"><small data-i18n="kpi3">RESPONSE TIME</small><strong id="ctr">24 min</strong></div>
        <div class="ads-kpi"><small data-i18n="kpi4">SATISFACTION</small><strong id="cpa">98.7%</strong></div>
      </div>
      <div class="ads-chart"><div class="live-line"></div></div>
      <div class="ad-status"><span class="pulse"></span> <span data-i18n="dash_status">Services active</span> &middot; <b data-i18n="dash_teams">6 teams deployed</b> &middot; updates every 2.4s</div>
    </div>
  </div>
</section>

<style>
  .ads { border: 1px solid var(--line); border-radius: 26px; background: #f5f6f8; color: #16181d; overflow: hidden; box-shadow: 0 40px 100px rgba(0,0,0,.28) }
  .ads-head { padding: 15px 18px; border-bottom: 1px solid #dfe1e6; display: flex; gap: 16px; align-items: center; font-size: 11px }
  .ads-dot { width: 9px; height: 9px; border-radius: 50%; background: #21c87a; box-shadow: 0 0 0 5px rgba(33,200,122,.1) }
  .ads-body { padding: 24px }
  .ads-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px }
  .ads-kpi { background: white; border: 1px solid #e2e4e8; border-radius: 14px; padding: 16px }
  .ads-kpi small { color: #737983; font-size: 10px }
  .ads-kpi strong { display: block; font-size: 23px; margin-top: 8px }
  .ads-chart { height: 150px; margin-top: 12px; border-radius: 14px; background: linear-gradient(#fff,#f8f9fb); border: 1px solid #e2e4e8; position: relative; overflow: hidden }
  .live-line { position: absolute; left: -10%; right: 0; bottom: 26px; height: 80px; border-top: 3px solid #e3062f; transform: skewY(-9deg); animation: live 2.8s linear infinite }
  @keyframes live { from { left: -30% } to { left: 110% } }
  .ad-status { display: flex; gap: 8px; align-items: center; font-size: 10px; color: #4b515a; margin-top: 12px }
  .pulse { width: 6px; height: 6px; border-radius: 50%; background: #e3062f; animation: pulse 1s infinite }
  @keyframes pulse { 50% { opacity: .25 } }

  @media (max-width: 850px) {
    .ads-grid { grid-template-columns: repeat(2,1fr) }
  }
</style>
