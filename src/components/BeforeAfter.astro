---
<section class="section" id="transformation">
  <div class="section-head reveal">
    <div><div class="kicker" data-i18n="s4_kicker">04 / Transformation</div><h2 data-i18n="s4_h1">Before.<br>After.</h2></div>
    <p data-i18n="s4_desc">Drag the slider to compare a generic contractor result with HomePro quality workmanship.</p>
  </div>
  <div class="compare reveal">
    <div class="layer after-layer"></div>
    <div class="layer before-layer"></div>
    <span class="compare-label before-label" data-i18n="before">BEFORE</span>
    <span class="compare-label after-label" data-i18n="after">AFTER</span>
    <input id="compareRange" type="range" min="0" max="100" value="50" aria-label="Compare before and after" />
    <div class="handle" id="handle"></div>
  </div>
</section>

<style>
  .compare { position: relative; height: 520px; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; background: #111 }
  .compare .layer { position: absolute; inset: 0; background-size: cover; background-position: center }
  .after-layer { background-image: linear-gradient(120deg,rgba(227,6,47,.2),transparent),url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80') }
  .before-layer { background-image: linear-gradient(120deg,#1b1d21,#090a0c); width: 50%; overflow: hidden }
  .compare-label { position: absolute; padding: 8px 11px; border: 1px solid rgba(255,255,255,.2); border-radius: 999px; font-size: 9px; letter-spacing: .18em }
  .compare-label.before-label { left: 25px; top: 25px }
  .compare-label.after-label { right: 25px; top: 25px }
  .compare input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; z-index: 5 }
  .handle { position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: #fff; z-index: 4; pointer-events: none }
  .handle:after { content: "\2194"; position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center; background: #fff; color: #111; font-weight: 700 }

  @media (max-width: 850px) {
    .compare { height: 390px }
  }
</style>
