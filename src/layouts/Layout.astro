---
export interface Props {
  title?: string;
  description?: string;
}

const { title = "HomePro Services — Premium Home Services", description = "Premium residential services for American homeowners. Plumbing, electrical, HVAC, painting, landscaping and more — delivered with precision." } = Astro.props;
---

