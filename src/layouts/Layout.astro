  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const $ = (s: string, p: Element | Document = document) => p.querySelector(s);
      const $$ = (s: string, p: Element | Document = document) => [...p.querySelectorAll(s)] as HTMLElement[];

      let currentLang = localStorage.getItem('homepro_lang') || 'en';
      const CONFIG = (window as any).CONFIG;
      const I18N = (window as any).I18N;

      function setLang(lang: string) {
        currentLang = lang;
        localStorage.setItem('homepro_lang', lang);
        const t = I18N[lang];
        if (!t) return;

        $$('[data-i18n]').forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (t[key] !== undefined) el.innerHTML = t[key];
        });
        $$('[data-i18n-placeholder]').forEach(el => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (t[key] !== undefined) (el as HTMLInputElement).placeholder = t[key];
        });

        const m = t.marquee;
        const html = m.map((s: string) => s.replace(/^(\**)(.+?)\**$/m, (_: string, b: string, w: string) => b ? `<b>${w}</b>` : w)).map((s: string) => `<span>${s}</span>`).join('');
        const track = $('#marqueeTrack');
        if (track) track.innerHTML = html + html;

        $$('.lang-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.lang === lang));
        document.documentElement.lang = lang === 'pt' ? 'pt-BR' : lang === 'es' ? 'es' : 'en-US';

        (window as any)._waLabels = { name: t.wa_label_name, addr: t.wa_label_addr, email: t.wa_label_email, service: t.wa_label_service, prefix: t.wa_msg_prefix, status: t.form_status };
      }

      $$('.lang-btn').forEach(btn => btn.addEventListener('click', () => setLang(btn.dataset.lang!)));
      setLang(currentLang);

      const light = $('.cursor-light'), dot = $('.cursor-dot');
      if (light && dot) {
        let mx = innerWidth / 2, my = innerHeight / 2, dx = mx, dy = my;
        addEventListener('pointermove', e => {
          mx = e.clientX; my = e.clientY;
          light.style.setProperty('--mx', mx + 'px');
          light.style.setProperty('--my', my + 'px');
        });
        function cursorLoop() {
          dx += (mx - dx) * .18; dy += (my - dy) * .18;
          dot.style.left = dx + 'px'; dot.style.top = dy + 'px';
          requestAnimationFrame(cursorLoop);
        }
        cursorLoop();
      }

      $$('.tilt').forEach(card => {
        card.addEventListener('pointermove', e => {
          const r = card.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
          card.style.transform = `perspective(900px) rotateX(${y * -7}deg) rotateY(${x * 8}deg) translateY(-3px)`;
        });
        card.addEventListener('pointerleave', () => card.style.transform = '');
      });

      if ((window as any).gsap) {
        (window as any).gsap.registerPlugin((window as any).ScrollTrigger);
        (window as any).gsap.utils.toArray('.reveal').forEach((el: HTMLElement) => {
          (window as any).gsap.fromTo(el, { autoAlpha: 0, y: 32 }, { autoAlpha: 1, y: 0, duration: .9, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 86%', once: true } });
        });
        (window as any).gsap.from('.hero-content > *', { y: 35, autoAlpha: 0, duration: 1, stagger: .12, ease: 'power3.out', delay: .15 });
        (window as any).gsap.to('.hero-media', { scale: 1.08, scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1 } });
      } else {
        document.documentElement.classList.add('no-gsap');
      }

      const drawObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          $$('.draw-chart', entry.target).forEach(svg => {
            $$('.line', svg).forEach((p, i) => {
              const len = (p as SVGPathElement).getTotalLength();
              (p as SVGPathElement).style.strokeDasharray = String(len);
              (p as SVGPathElement).style.strokeDashoffset = String(len);
              (p as SVGPathElement).animate([{ strokeDashoffset: String(len) }, { strokeDashoffset: '0' }], { duration: 1700, delay: i * 180, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'forwards' });
            });
          });
          drawObserver.unobserve(entry.target);
        });
      }, { threshold: .3 });
      $$('.draw-chart').forEach(x => drawObserver.observe(x));

      const fmt = (n: number) => new Intl.NumberFormat('en-US').format(n);
      let data = { jobs: 1842, reviews: 947, response: 24, satisfaction: 98.7 };
      setInterval(() => {
        data.jobs += Math.floor(Math.random() * 8 + 2); data.reviews += Math.floor(Math.random() * 4 + 1);
        data.response = Math.max(12, data.response + (Math.random() - .52) * .8);
        data.satisfaction = Math.min(99.9, Math.max(95, data.satisfaction + (Math.random() - .5) * .04));
        const imp = $('#impressions'), clk = $('#clicks'), ctr = $('#ctr'), cpa = $('#cpa');
        if (imp) imp.textContent = fmt(data.jobs);
        if (clk) clk.textContent = fmt(data.reviews);
        if (ctr) ctr.textContent = Math.round(data.response) + ' min';
        if (cpa) cpa.textContent = data.satisfaction.toFixed(1) + '%';
      }, 2400);

      const range = $('#compareRange') as HTMLInputElement | null, before = $('.before-layer'), handle = $('#handle');
      if (range && before && handle) {
        function updateCompare() { (before as HTMLElement).style.width = range.value + '%'; (handle as HTMLElement).style.left = range.value + '%'; }
        range.addEventListener('input', updateCompare); updateCompare();
      }

      $$('.faq-item').forEach(item => {
        const q = $('.faq-q', item), a = $('.faq-a', item);
        if (!q || !a) return;
        q.addEventListener('click', () => {
          const open = item.classList.contains('open');
          $$('.faq-item.open').forEach(other => {
            if (other !== item) { other.classList.remove('open'); const aa = $('.faq-a', other); if (aa) (aa as HTMLElement).style.height = '0px'; }
          });
          item.classList.toggle('open', !open);
          (a as HTMLElement).style.height = !open ? a.scrollHeight + 'px' : '0px';
        });
      });

      const leadForm = $('#leadForm');
      if (leadForm) {
        leadForm.addEventListener('submit', e => {
          e.preventDefault();
          const form = new FormData(e.currentTarget as HTMLFormElement);
          const wl = (window as any)._waLabels || { name: 'Name', addr: 'Address', email: 'Email', service: 'Service needed', prefix: 'Hello!', status: 'Opening WhatsApp...' };
          const nome = form.get('nome'), empresa = form.get('empresa') || '—', email = form.get('email'), mensagem = form.get('mensagem') || '—';
          const text = `${wl.prefix}%0A%0A*${wl.name}:* ${encodeURIComponent(nome as string)}%0A*${wl.addr}:* ${encodeURIComponent(empresa as string)}%0A*${wl.email}:* ${encodeURIComponent(email as string)}%0A*${wl.service}:* ${encodeURIComponent(mensagem as string)}`;
          const url = `https://wa.me/${CONFIG.whatsapp}?text=${text}`;
          const status = $('#formStatus');
          if (status) status.textContent = wl.status;
          window.dataLayer.push({ event: 'generate_lead', lead_source: 'whatsapp_form', lead_name: nome });
          if ((window as any).gtag) (window as any).gtag('event', 'generate_lead', { method: 'WhatsApp', source: 'landing_page' });
          if ((window as any).fbq) (window as any).fbq('track', 'Lead', { content_name: 'WhatsApp Form' });
          window.open(url, '_blank', 'noopener');
        });
      }

      $$('[data-track]').forEach(el => el.addEventListener('click', () => {
        const eventName = (el as HTMLElement).dataset.track;
        window.dataLayer.push({ event: 'cta_click', cta_name: eventName });
        if ((window as any).gtag) (window as any).gtag('event', 'cta_click', { cta_name: eventName });
        if ((window as any).fbq) (window as any).fbq('trackCustom', 'CTAClick', { cta_name: eventName });
      }));
    });
  </script>
</head>

