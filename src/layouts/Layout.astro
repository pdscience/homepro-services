  .cursor-dot { position: fixed; width: 8px; height: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 22px 7px rgba(255,255,255,.25);
    transform: translate(-50%,-50%); pointer-events: none; z-index: 10000; mix-blend-mode: difference }

  .section { width: min(var(--max),100%); margin: 0 auto; padding: 125px 28px }
