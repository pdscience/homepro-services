  .kicker { font-size: 10px; text-transform: uppercase; letter-spacing: .22em; color: var(--red) }
  .section h2 { font-family: "Space Grotesk"; font-size: clamp(38px,5.5vw,76px); line-height: .94; letter-spacing: -.06em; margin: 10px 0 0 }
  .section-head p { max-width: 390px; color: var(--muted); line-height: 1.65; font-size: 13px }

  .btn { border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 13px 18px; background: rgba(255,255,255,.05); color: #fff; cursor: pointer; transition: .3s var(--ease) }
  .btn:hover { transform: translateY(-2px); background: rgba(255,255,255,.11) }
  .btn.primary { background: #fff; color: #050608; border-color: #fff; font-weight: 700 }

  .reveal { opacity: 0; transform: translateY(28px) }

  html.no-gsap .reveal, html.no-js .reveal { opacity: 1; transform: none }

  @media (max-width: 850px) {
    .section { padding: 90px 20px }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *:before, *:after { scroll-behavior: auto !important; animation: none !important; transition: none !important }
    .reveal { opacity: 1; transform: none }
  }
</style>
