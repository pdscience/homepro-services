---
import Layout from '../layouts/Layout.astro';
import FlagStrip from '../components/FlagStrip.astro';
import CursorEffects from '../components/CursorEffects.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Differentials from '../components/Differentials.astro';
import Results from '../components/Results.astro';
import Dashboard from '../components/Dashboard.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Hurricane from '../components/Hurricane.astro';
import Marquee from '../components/Marquee.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout gsap>
  <FlagStrip />
  <CursorEffects />
  <Navbar />
  <Hero />

  <main>
    <Services />
    <Differentials />
    <Results />
    <Dashboard />
    <BeforeAfter />
    <Hurricane />
    <Marquee />
    <FAQ />
    <ContactForm />
    <section class="section" id="join">
      <div class="cta-banner reveal">
        <div>
          <div class="kicker" data-i18n="prosign_kicker">07 / For pros</div>
          <h2 data-i18n="prosign_h1">Are you a pro?<br />Join us.</h2>
          <p data-i18n="prosign_desc">Offer your services across Florida. Apply in 1 minute — we review every application and publish approved pros in our directory.</p>
        </div>
        <a class="btn primary" href="/profissional"><span data-i18n="prosign_btn">Apply now</span> &uarr;</a>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>

  <style>
    .cta-banner { display: flex; justify-content: space-between; align-items: center; gap: 40px;
      border: 1px solid var(--line); border-radius: 30px; padding: 50px;
      background: linear-gradient(145deg,#0c0e12,#07080a); position: relative; overflow: hidden }
    .cta-banner:after { content: ""; position: absolute; width: 400px; height: 400px; right: -150px; top: -150px;
      background: var(--red); filter: blur(130px); opacity: .12 }
    .cta-banner h2 { font-size: clamp(34px,4.5vw,58px) }
    .cta-banner p { color: var(--muted); line-height: 1.7; font-size: 13px; max-width: 520px }
    .cta-banner .btn { position: relative; z-index: 2; white-space: nowrap }

    @media (max-width: 850px) {
      .cta-banner { flex-direction: column; align-items: start; padding: 30px }
    }
  </style>
</Layout>
